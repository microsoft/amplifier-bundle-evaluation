+SID_RE = re.compile(r"Session ID:\s*([0-9a-f-]{8,})")
+RESUME_RE = re.compile(r"Resuming session:\s*([0-9a-f-]{8,})")
+
+
 def capture_sid(out: str) -> str | None:
-    m = re.search(r"Session ID:\s*([0-9a-f-]{8,})", out)
+    """Return the session id THIS turn ran in, whichever way the CLI printed it.
+
+    Turn 1 prints `Session ID: <sid>`. `amplifier run --resume` does NOT
+    re-print that line -- it prints `Resuming session: <sid>` instead. Matching
+    only the first phrasing made every turn after the first return None, which
+    is why `session_continuity_ok` below was False for 151/151 driver records
+    ever recorded by this driver (audit: model_performance-i0cm).
+    """
+    m = SID_RE.search(out) or RESUME_RE.search(out)
     return m.group(1) if m else None
 
 
+def continuity_ok(turns: list[dict]) -> bool:
+    """True iff every turn we could OBSERVE ran in the same session.
+
+    A turn whose host-side stdout capture came back empty (`out_len == 0`) is
+    unobserved, not broken: the container executed it and the transport lost
+    the copy. It is excluded from the identity check and reported separately as
+    `turn_captures_empty` -- never silently absorbed. A turn that produced
+    output but no session line at all (e.g. a TIMEOUT stub) IS a break.
+    """
+    if not turns:
+        return False
+    sids = [t["session_id"] for t in turns if t["session_id"]]
+    empty = [t for t in turns if t.get("out_len") == 0]
+    return bool(sids) and len(set(sids)) == 1 and len(sids) + len(empty) == len(turns)
+
+
